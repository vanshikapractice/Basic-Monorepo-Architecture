{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "declaration": true,
    "declarationMap": true,
    "baseUrl": ".",
    "paths": {
      "@payment/shared-types": ["packages/shared-types/src"],
      "@payment/api": ["apps/api/src"],
      "@payment/web": ["apps/web/src"]
    }
  },
  "exclude": ["node_modules", "dist", "build", ".turbo"]
}